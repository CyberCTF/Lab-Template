# Lab host VM for this lab: a Debian 12 VM that runs the lab's docker-compose.yml.
# Local hypervisors (virtualbox, vmware_desktop, parallels, hyperv, libvirt) and
# an ESXi server (vmware_esxi). The launcher runs this with
#   vagrant up --provider <id>
# and passes the evidence claim + server connection as environment variables
# (contract: cyber-ctf-desktop docs/server.md).

LAB_DIR = File.expand_path("../..", __dir__)

Vagrant.configure("2") do |config|
  config.vm.define "labhost"
  config.vm.hostname = "labhost"
  config.vm.box = "bento/debian-12"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # The lab files, copied over SSH (works on every host OS, no shared folders or rsync).
  %w[docker-compose.yml build evidence deploy/ansible].each do |path|
    next unless File.exist?(File.join(LAB_DIR, path))
    config.vm.provision "file", source: File.join(LAB_DIR, path), destination: "/tmp/lab/#{path}"
  end
  config.vm.provision "shell", inline: "rm -rf /opt/lab && mv /tmp/lab /opt/lab"
  # ansible-core only: Debian's full "ansible" package takes minutes to byte-compile.
  config.vm.provision "shell", inline: "command -v ansible-playbook >/dev/null || (apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ansible-core)"

  # Ansible runs inside the VM (installed there by Vagrant), never on the player's machine.
  config.vm.provision "ansible_local" do |a|
    a.provisioning_path = "/opt/lab/deploy/ansible"
    a.playbook = "site.yml"
    a.install = false
    a.extra_vars = {
      ctf_api_url: ENV.fetch("CTF_API_URL", ""),
      ctf_launch_token: ENV.fetch("CTF_LAUNCH_TOKEN", ""),
      attackbox_image: ENV.fetch("CYBERCTF_ATTACKBOX_IMAGE", ""),
    }
  end

  config.vm.provider "virtualbox" do |v|
    v.cpus = 2
    v.memory = 4096
  end
  config.vm.provider "vmware_desktop" do |v|
    v.vmx["numvcpus"] = "2"
    v.vmx["memsize"] = "4096"
  end
  config.vm.provider "parallels" do |v|
    v.cpus = 2
    v.memory = 4096
  end
  config.vm.provider "hyperv" do |v, override|
    override.vm.box = "generic/debian12"
    v.cpus = 2
    v.maxmemory = 4096
  end
  config.vm.provider "libvirt" do |v, override|
    override.vm.box = "generic/debian12"
    v.cpus = 2
    v.memory = 4096
  end

  # Server: the player's ESXi host (plugin vagrant-vmware-esxi, uses vmware_desktop boxes).
  config.vm.provider "vmware_esxi" do |esxi|
    esxi.esxi_hostname = ENV["CYBERCTF_ESXI_HOSTNAME"]
    esxi.esxi_hostport = Integer(ENV.fetch("CYBERCTF_ESXI_HOSTPORT", "22"))
    esxi.esxi_username = ENV.fetch("CYBERCTF_ESXI_USERNAME", "root")
    esxi.esxi_password = "env:CYBERCTF_ESXI_PASSWORD"
    esxi.esxi_disk_store = ENV["CYBERCTF_ESXI_DISK_STORE"] if ENV["CYBERCTF_ESXI_DISK_STORE"]
    esxi.esxi_virtual_network = ENV["CYBERCTF_ESXI_VIRTUAL_NETWORK"] if ENV["CYBERCTF_ESXI_VIRTUAL_NETWORK"]
    esxi.guest_numvcpus = 2
    esxi.guest_memsize = 4096
  end
end
